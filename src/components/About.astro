---
import "../styles/global.css";
---

<div
  class="flex justify-center content-center items-center gap-10 align-middle w-3/4 md:w-1/2"
>
  <!-- abt text -->
  <div class="text-(--muted2) text-sm leading-loose text-center">
    <p class="mb-5">
      Hello! I'm Will Stephenson, a software developer with a deep passion for
      real-time graphics and designing systems. I love building things at the
      intersection of math, physics, and visualization.
    </p>
    <p class="mb-5">
      My work ranges from a modern Vulkan renderer with PBR lighting, bindless
      descriptors, frustum culling, and hot shader reloading to GPU-accelerated
      particle systems and fluid simulations using compute shaders. I'm equally
      comfortable working on gameplay systems and AR experiences.
    </p>
    <p class="mb-10">
      I approach every project with a focus on performance, clean architecture,
      and pushing hardware to its limits.
    </p>

    <div class="text-xs uppercase text-(--accent) mb-3">Languages</div>

    <div
      class="flex px-5 pb-6 justify-center flex-wrap gap-2 *:text-xs *:px-2 *:py-2 *:bg-(--surface2) text-(--muted2) *:border-2 *:border-solid *:border-(--border) *:rounded-xs"
    >
      <div>C++</div>
      <div>C</div>
      <div>Python</div>
      <div>JavaScript</div>
      <div>C#</div>
      <div>Rust</div>
      <div>Java</div>
      <div>GLSL</div>
      <div>Slang</div>
      <div>HLSL</div>
    </div>
    <div class="text-xs uppercase text-(--accent) mb-3">Tools</div>
    <div
      class="flex px-5 pb-6 justify-center flex-wrap gap-2 *:text-xs *:px-2 *:py-2 *:bg-(--surface2) text-(--muted2) *:border-2 *:border-solid *:border-(--border) *:rounded-xs"
    >
      <div>RenderDoc</div>
      <div>NSight Graphics</div>
      <div>CMake</div>
      <div>Git</div>
      <div>GDB</div>
      <div>VS Debugger</div>
    </div>
    
    <div class="text-xs uppercase text-(--accent) mb-3">APIs & Libraries</div>
    <div
    class="flex px-5 pb-6 justify-center flex-wrap gap-2 *:text-xs *:px-2 *:py-2 *:bg-(--surface2) text-(--muted2) *:border-2 *:border-solid *:border-(--border) *:rounded-xs"
    >
    <div>Vulkan</div>
    <div>OpenGL</div>
    <div>WebGPU</div>
    <div>Astro</div>
    <div>DearImGui</div>
    <div>VMA</div>
  </div>
  </div>
</div>
