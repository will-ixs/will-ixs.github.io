---
import "../styles/global.css";
---

<div
  class="relative z-10 h-full flex flex-col items-center justify-center pt-5 px-12 pb-5"
>
  <h1
    class="text-(--text) text-shadow-lg text-5xl md:text-6xl font-bold transition-all duration-500 ease-out my-5"
  >
    Connect
  </h1>
</div>

<section
  class="relative items-center justify-center text-center overflow-hidden max-w-175 mx-auto"
>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-1.25">
    <div
      class="flex flex-col justify-center gap-0 overflow-hidden col-span-1 mb-12"
    >
      <a
        href="https://bsky.app/profile/willowsea.bsky.social"
        target="_blank"
        class="py-5 border-2 mb-2.5 border-solid border-transparent hover:border-(--border) decoration-0 block transition-all"
      >
        <span class="text-(--accent) uppercase block mb-2 text-sm">Bluesky</span
        >
        <span class="text-sm block text-(--text)">@willowsea</span>
      </a>
    </div>
    <div
      class="flex flex-col justify-center gap-0 overflow-hidden col-span-1 mb-12"
    >
      <a
        href="https://github.com/will-ixs"
        target="_blank"
        class="py-5 border-2 mb-2.5 border-solid border-transparent hover:border-(--border) decoration-0 block transition-all"
      >
        <span class="text-(--accent) uppercase block mb-2 text-sm">Github</span>
        <span class="text-sm block text-(--text)">@will-ixs</span>
      </a>
    </div>
    <div
      class="flex flex-col justify-center gap-0 overflow-hidden col-span-1 mb-12"
    >
      <a
        href="mailto:wmstephenson9@gmail.com"
        target="_blank"
        class="py-5 border-2 mb-2.5 border-solid border-transparent hover:border-(--border) decoration-0 block transition-all"
      >
        <span class="text-(--accent) uppercase block mb-2 text-l">Email</span>
        <span class="text-l block text-(--text)">wmstephenson9@gmail.com</span>
      </a>
    </div>
  </div>
</section>
